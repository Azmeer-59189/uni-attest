# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/degree_attestation

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this
REFRESH_TOKEN_SECRET=another-secret-key

# Frontend URL
CLIENT_URL=http://localhost:5173

# University Info
UNIVERSITY_NAME=Your University Name

# Optional face verification service
FACE_SERVICE_URL=http://127.0.0.1:5001

# Email (optional). Set host, user and password to send students status emails.
# For Gmail, use an app password. MAIL_FROM defaults to SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=registrar@university.edu

# Fee challan (optional). Bank details printed on the challan, and fee overrides in PKR.
# FEE_BANK_NAME=National Bank of Pakistan
# FEE_ACCOUNT_TITLE=University Attestation Fee
# FEE_ACCOUNT_NUMBER=0000-0000000000
# FEE_CHALLAN_VALID_DAYS=15
# FEE_DEGREE_NORMAL=2000
# FEE_DEGREE_URGENT=4000

# Blockchain (Polygon Amoy Testnet - FREE)
AMOY_RPC_URL=https://polygon-amoy.drpc.org
PRIVATE_KEY=your-wallet-private-key-without-0x
CONTRACT_ADDRESS=0x...
# When true, issuance waits for confirmed blockchain proof; retries keep the same hash.
# To run locally without blockchain, remove PRIVATE_KEY and CONTRACT_ADDRESS.
BLOCKCHAIN_REQUIRED=false

# Optional first-admin setup. Omit ADMIN_PASSWORD to generate a random password.
ADMIN_EMAIL=admin@university.edu
# ADMIN_PASSWORD=choose-a-password-between-12-and-72-bytes
