# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/degree_attestation

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this
REFRESH_TOKEN_SECRET=another-secret-key

# Frontend URL
CLIENT_URL=http://localhost:5173

# University Info
UNIVERSITY_NAME=Your University Name

# Optional face verification service
FACE_SERVICE_URL=http://127.0.0.1:5001

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Blockchain (Polygon Amoy Testnet - FREE)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
PRIVATE_KEY=your-wallet-private-key-without-0x
CONTRACT_ADDRESS=0x...

# Polygonscan
POLYGONSCAN_API_KEY=your-api-key

# IPFS (Filebase - 5GB Free)
IPFS_API_KEY=your-key
IPFS_SECRET=your-secret
IPFS_BUCKET=your-bucket
